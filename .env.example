# Copy to .env locally or set these in your hosting dashboard.
# Never commit real secrets or production credentials.

NODE_ENV=production
PORT=5000

# Required for production WebAuthn challenge persistence
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/education
MONGODB_DB_NAME=education

# Frontend origin the browser will report to WebAuthn (no trailing slash)
WEBAUTHN_ORIGIN=https://your-production-frontend-domain
FRONTEND_ORIGIN=https://your-production-frontend-domain

# RP ID must be the effective domain of the frontend origin (hostname only, no https://)
WEBAUTHN_RP_ID=your-production-frontend-domain

# Backend public URL. Required when frontend and API are on different hosts.
BACKEND_ORIGIN=https://your-production-backend-domain
PUBLIC_API_BASE=https://your-production-backend-domain

# Comma-separated extra allowed CORS origins (credentials enabled; never use *)
CORS_ORIGINS=https://your-production-frontend-domain

# Cross-site cookies: set COOKIE_SAMESITE=None and COOKIE_SECURE=true
# when the frontend origin host differs from the API host.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true
# COOKIE_DOMAIN=
